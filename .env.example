# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Random secret for signing session cookies (at least 32 characters)
SESSION_SECRET="docs-assignment-dev-session-secret-key-32chars"

# Browserless PDF export (https://www.browserless.io/)
BROWSERLESS_API_KEY=""
